# Servidor de experimentación independiente de la imagen de inferencia.
FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN python -m pip install --no-cache-dir \
      'mlflow==3.17.2' 'psycopg[binary]==3.3.6' 'boto3==1.43.118' \
    && groupadd --system mlflow && useradd --system --gid mlflow --home /mlflow mlflow \
    && mkdir -p /mlflow/state /mlflow/artifacts \
    && chown -R mlflow:mlflow /mlflow
WORKDIR /mlflow
USER mlflow
EXPOSE 5000
