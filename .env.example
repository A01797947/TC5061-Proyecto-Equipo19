# Copia este archivo como .env y llena los valores. Nunca subas .env.
# Pide las credenciales por un canal privado.

# PostgreSQL de Supabase (Session pooler). Prefijo obligatorio: postgresql+psycopg://
DATABASE_URL=

# Supabase Storage (compatible con S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
MLFLOW_S3_ENDPOINT_URL=

# Artefactos servidos por el servidor MLflow (van al bucket mlflow-artifacts)
MLFLOW_ARTIFACT_LOCATION=mlflow-artifacts:/